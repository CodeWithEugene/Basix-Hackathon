# Optional. Without it, visit notes fall back to manual danger-sign toggles
# (which is also how the offline community agent works).
TYPESAFE_API_KEY=

# Agent ports (defaults shown)
MIZANI_COMMUNITY_PORT=8101
MIZANI_FACILITY_PORT=8102
MIZANI_PEER=http://127.0.0.1:8102

# Web app (server-side only, never exposed to the browser)
AGENT_COMMUNITY_URL=http://127.0.0.1:8101
AGENT_FACILITY_URL=http://127.0.0.1:8102
